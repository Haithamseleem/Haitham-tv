<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://haitham.tv/home" version="0.1.0" viewmodes="maximized">
  <tizen:application id="HaithamHome1.HaithamHome" package="HaithamHome1" required_version="2.4"/>
  <name>Haitham Home</name>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:app-control>
    <tizen:src name="index.html" reload="disable"/>
    <tizen:operation name="http://tizen.org/appcontrol/operation/main"/>
  </tizen:app-control>
  <tizen:profile name="tv"/>
  <tizen:setting screen-orientation="landscape" background-support="disable" encryption="disable" hwkey-event="enable"/>
</widget>
